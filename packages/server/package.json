{
  "name": "@foundation/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server core: cqrs (typed bus), db, migrate, auth, limits, cors, health, jobs, outbox, features/*",
  "exports": {
    ".": "./src/index.ts",
    "./features/*/contract": "./src/features/*/contract.ts",
    "./features/*/server": "./src/features/*/server.ts",
    "./features/*/client": "./src/features/*/client.ts",
    "./migrations": "./src/db/migrations/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@foundation/contracts": "workspace:*",
    "@foundation/jest-verify": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@foundation/testkit": "workspace:*",
    "@types/node": "^24.10.0",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
