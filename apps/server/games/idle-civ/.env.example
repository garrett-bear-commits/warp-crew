# Idle Civilization — local development (one deployment = one game + one env, ADR-003)
DATABASE_URL=postgres://postgres:postgres@localhost:55442/foundation_dev
PGSSL=off
GAME_ID=idle-civ
GAME_ENV=dev
PORT=8080
ADMIN_PORT=8081
IDENTITY_PROVIDER=mock
PAYMENTS_PROVIDER=mock
ADMIN_KEYS='{"dev":{"secretSha256":"cef324ca411ad0f7380f201da094598e4776500611bd169da3b226db7a636b41","scopes":["read","support","grant","publish","restore","erase"]}}'
OPS_SECRET=dev-ops-secret-change-me
RATE_LIMIT_STORE=memory
BUILD_VERSION=dev
CLIENT_ORIGINS=http://localhost:5174
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info

# ── Optional (packages/server/src/config.ts; docs/using-the-core/testing-and-release.md) ──
# GAME_CONFIG=<games/<id>/ name>   rules to load when GAME_ID (the exact signed token audience, e.g. a
#                                  Jest game UUID) differs from the games/<id>/ folder; default GAME_ID
# PG_POOL=8                        connections per API process; unset: 20 when GAME_ENV=prod, 8 elsewhere
# SENTRY_DSN=https://<key>@<host>/<project>   API errors, spans, Crons; unset: no-op
# POSTHOG_LOGS_TOKEN=phc_<project token>      ship API logs to PostHog Logs over OTLP; unset: stdout only
# POSTHOG_LOGS_URL=https://us.i.posthog.com/i/v1/logs   OTLP logs endpoint (https in prod)
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com   with CF_ACCESS_AUD (both or neither):
# CF_ACCESS_AUD=<64-hex AUD tag>[,<next tag>]                 admin requests need a Cloudflare Access token
# TYPESAFE_API_KEY=<key>           Jev name moderation for POST /v1/names/check; unset: verdict `unchecked`
# BUILD_INFO_FILE=/app/build-info.json   deploy-written {"version","commit","env"}; wins over BUILD_VERSION /
#                                  BUILD_COMMIT. Prod needs a release X.Y.Z and a production record.
# BUILD_COMMIT=<git sha>           commit reported on /health/ready when no build record names one
