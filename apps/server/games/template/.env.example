# Template game — local development (one deployment = one game + one env, ADR-003)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/foundation_dev
PGSSL=off
GAME_ID=template
GAME_ENV=dev
PORT=8080
ADMIN_PORT=8081
IDENTITY_PROVIDER=mock
PAYMENTS_PROVIDER=mock
# JEST_JWS_SECRETS=<base64 secret>,<previous base64 secret>   (required when IDENTITY_PROVIDER=jest)
# ADMIN_KEYS: {"<keyId>": {"secretSha256": "<sha256 hex of the secret>", "scopes": ["read","support","grant","publish","restore","erase"]}}
# The dev key below is sha256("dev-admin-secret-change-me") — dev-only placeholder, never use in prod.
ADMIN_KEYS={"dev":{"secretSha256":"cef324ca411ad0f7380f201da094598e4776500611bd169da3b226db7a636b41","scopes":["read","support","grant","publish","restore","erase"]}}
OPS_SECRET=dev-ops-secret-change-me
RATE_LIMIT_STORE=memory
BUILD_VERSION=dev
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info
