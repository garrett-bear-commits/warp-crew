{
  "name": "@foundation/app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Composition root; games/<id>/ config; admin inspector static origin",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/cli/migrate.ts",
    "build": "vite build --config admin-inspector/vite.config.ts"
  },
  "dependencies": {
    "@foundation/contracts": "workspace:*",
    "@foundation/jest-verify": "workspace:*",
    "@foundation/server": "workspace:*",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.0",
    "postgres": "^3.4.9",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@foundation/testkit": "workspace:*",
    "@types/node": "^24.10.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
